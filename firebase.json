{
  "hosting": {
    "public": "dist",
    "predeploy": ["npm run build"],
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "terraApi", "region": "southamerica-east1" } },
      { "source": "/functions/receiveSensorData", "function": { "functionId": "terraApi", "region": "southamerica-east1" } },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "**", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }, { "key": "X-Frame-Options", "value": "DENY" }] },
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }] }
    ]
  },
  "functions": [{
    "source": "firebase-functions",
    "codebase": "terra-nova",
    "runtime": "nodejs24",
    "ignore": ["node_modules", ".git", "*.log", ".env.local", ".secret.local"],
    "predeploy": ["node scripts/prepare-firebase.mjs", "npm --prefix \"$RESOURCE_DIR\" ci --no-audit --no-fund"]
  }],
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "emulators": {
    "firestore": { "host": "127.0.0.1", "port": 8080 },
    "functions": { "host": "127.0.0.1", "port": 5001 },
    "hosting": { "host": "127.0.0.1", "port": 5000 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
