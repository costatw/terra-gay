PORT=3000
DATA_DIR=./data
STORAGE_BACKEND=sqlite
# Estes valores são para o servidor local. No Spark, o navegador usa Auth/Firestore; consulte FIREBASE.md.
PUBLIC_ORIGIN=http://localhost:3000
# Em produção: NODE_ENV=production e PUBLIC_ORIGIN=https://seu-dominio
# Para receber sensores, defina uma chave privada longa:
SENSOR_API_KEY=
# Opcional: link real do checkout. Sem ele, a assinatura usa atendimento via WhatsApp.
CHECKOUT_URL=
# Para recuperação de senha e avisos por e-mail:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
CONTACT_EMAIL=terra.nova.sustentabilidade@gmail.com
